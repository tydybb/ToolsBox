<Window x:Class="ToolsBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ports="clr-namespace:ToolsBox.App.Ports"
        xmlns:unlocking="clr-namespace:ToolsBox.App.FileUnlocking"
        xmlns:network="clr-namespace:ToolsBox.App.NetworkTraffic"
        xmlns:countdown="clr-namespace:ToolsBox.App.WorkCountdown"
        xmlns:views="clr-namespace:ToolsBox.App.Views"
        xmlns:web="clr-namespace:ToolsBox.App.WebResources"
        xmlns:lottery="clr-namespace:ToolsBox.App.Lottery"
        Title="宝哥工具箱" Icon="Assets/baoge-toolbox.ico" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ToolboxBackgroundBrush}"
        Foreground="{DynamicResource ToolboxTextBrush}" FontFamily="Segoe UI, Microsoft YaHei" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ComfortControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ToolNavigationStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="14,13"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ToolboxMutedBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                                </Border>
                                <Border x:Name="SelectionIndicator" Width="3" Height="22" CornerRadius="2" Background="{DynamicResource ToolboxAccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ToolboxHoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ToolboxSurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ToolboxAccentBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ToolboxAccentBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NavigationIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Margin" Value="0,0,13,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <DataTemplate DataType="{x:Type ports:PortMonitorViewModel}"><views:PortMonitorView/></DataTemplate>
            <DataTemplate DataType="{x:Type unlocking:FileUnlockerViewModel}"><views:FileUnlockerView/></DataTemplate>
            <DataTemplate DataType="{x:Type network:NetworkTrafficViewModel}"><views:NetworkTrafficView/></DataTemplate>
            <DataTemplate DataType="{x:Type countdown:WorkCountdownViewModel}"><views:WorkCountdownView/></DataTemplate>
            <DataTemplate DataType="{x:Type lottery:LotteryViewModel}"><views:LotteryView/></DataTemplate>
            <DataTemplate DataType="{x:Type web:WebResourcesHome}">
                <StackPanel Margin="28">
                    <TextBlock Text="网页资源下载" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="网页浏览和下载在独立窗口运行。" Margin="0,6,0,24" Foreground="{DynamicResource ToolboxMutedBrush}"/>
                    <Border Style="{DynamicResource ToolboxCardStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="浏览、识别与下载" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="输入网页地址，勾选识别到的图片或视频进行下载；所需环境可在窗口内检测并安装。"
                                       Foreground="{DynamicResource ToolboxMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20" LineHeight="23"/>
                            <Button Content="打开网页资源窗口" Click="OpenWebResources" Style="{DynamicResource ToolboxPrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ToolboxSidebarBrush}" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,28,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource ToolboxAccentFillBrush}" CornerRadius="12" Width="40" Height="40">
                        <Image x:Name="BrandIcon" Source="Assets/baoge-toolbox-icon.png" Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="宝哥工具箱" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Windows 实用工具" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="全部工具" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="12" Margin="12,30,0,7"/>
                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="PortNavigation" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools" Command="{Binding ShowPortMonitorCommand}" IsChecked="{Binding IsPortMonitorSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="端口监控" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FileNavigation" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools" Command="{Binding ShowFileUnlockerCommand}" IsChecked="{Binding IsFileUnlockerSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="文件解除占用" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NetworkNavigation" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools" Command="{Binding ShowNetworkTrafficCommand}" IsChecked="{Binding IsNetworkTrafficSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="网络流量" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CountdownNavigation" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools" Command="{Binding ShowWorkCountdownCommand}" IsChecked="{Binding IsWorkCountdownSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="下班倒计时" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="WebResourcesNavigation" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools" Command="{Binding ShowWebResourcesCommand}" IsChecked="{Binding IsWebResourcesSelected, Mode=OneWay}" Click="OpenWebResources">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="网页资源下载" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LotteryNavigation" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools" Command="{Binding ShowLotteryCommand}" IsChecked="{Binding IsLotterySelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="双色球统计" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Button x:Name="ThemeToggleButton" Click="OnToggleTheme" Margin="0,12,0,16" HorizontalContentAlignment="Left" ToolTip="切换浅色或深色外观">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="ThemeToggleLabel" Text="切换为深色"/></StackPanel>
                    </Button>
                    <Border BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="0,1,0,0" Padding="12,14,0,0">
                        <StackPanel><TextBlock x:Name="VersionLabel" FontSize="12"/><TextBlock Text="让日常操作更轻松" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentTool}"/>
    </Grid>
</Window>
