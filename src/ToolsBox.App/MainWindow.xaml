<Window x:Class="ToolsBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolsBox · Windows 工具箱" Width="1280" Height="760"
        MinWidth="980" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CBD2D9"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#17212B">
            <Grid Margin="20,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="TOOLSBOX" Foreground="#FFFFFF" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Windows 工具箱" Foreground="#92A4B5" FontSize="12" Margin="1,4,0,0"/></StackPanel>
                <Border Grid.Row="1" Margin="0,34,0,0" Padding="14,12" CornerRadius="6" Background="#246BFD">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#8FC1FF" Margin="0,0,10,0"/><TextBlock Text="端口监控" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <TextBlock Grid.Row="3" Text="更多工具将逐步加入" Foreground="#728597" FontSize="11"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="端口监控" FontSize="28" FontWeight="SemiBold" Foreground="#1F2933"/><TextBlock Text="实时查看 TCP / UDP、IPv4 / IPv6 端口及占用进程" Foreground="#637381" Margin="0,5,0,0"/></StackPanel>
            <Grid Grid.Row="1" Margin="0,22,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索端口、PID、进程、协议、状态或地址"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,4,0" VerticalAlignment="Center"><TextBlock Text="刷新频率" VerticalAlignment="Center" Foreground="#52616B" Margin="0,0,8,0"/><ComboBox Width="78" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshIntervalSeconds}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} 秒}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <Button Grid.Column="2" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"/>
                <Button Grid.Column="3" Content="立即刷新" Command="{Binding RefreshCommand}" Background="#246BFD" Foreground="White" BorderBrush="#246BFD"/>
            </Grid>
            <Border Grid.Row="2" Padding="12,9" Margin="0,0,0,12" Background="#FFF3CD" CornerRadius="4" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorText}" Foreground="#7A5800" TextWrapping="Wrap"/></Border>
            <Border Grid.Row="3" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
                <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC" ColumnHeaderHeight="38" RowHeight="34" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="65"/><DataGridTextColumn Header="地址族" Binding="{Binding AddressFamilyDisplay}" Width="70"/>
                        <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="*" MinWidth="145"/><DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="85"/>
                        <DataGridTextColumn Header="远程地址" Binding="{Binding RemoteAddress}" Width="*" MinWidth="145"/><DataGridTextColumn Header="远程端口" Binding="{Binding RemotePort}" Width="85"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="105"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75"/><DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Grid Grid.Row="4" Margin="2,12,2,0"><TextBlock Text="{Binding StatusText}" Foreground="#52616B"/><TextBlock Text="{Binding LastRefreshText}" Foreground="#7B8794" HorizontalAlignment="Right"/></Grid>
        </Grid>
    </Grid>
</Window>
