<Window x:Class="ToolsBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ports="clr-namespace:ToolsBox.App.Ports"
        xmlns:unlocking="clr-namespace:ToolsBox.App.FileUnlocking"
        xmlns:network="clr-namespace:ToolsBox.App.NetworkTraffic"
        xmlns:archive="clr-namespace:ToolsBox.App.ArchiveRecovery"
        xmlns:views="clr-namespace:ToolsBox.App.Views"
        Title="宝哥工具箱" Icon="Assets/baoge-toolbox.ico" Width="1280" Height="760" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="ToolNavigationStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#263442"/>
            <Setter Property="BorderBrush" Value="#34495B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#34495B"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#246BFD"/>
                    <Setter Property="BorderBrush" Value="#246BFD"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#8FC1FF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CBD2D9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CBD2D9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CBD2D9"/></Style>
        <DataTemplate DataType="{x:Type ports:PortMonitorViewModel}"><views:PortMonitorView/></DataTemplate>
        <DataTemplate DataType="{x:Type unlocking:FileUnlockerViewModel}"><views:FileUnlockerView/></DataTemplate>
        <DataTemplate DataType="{x:Type network:NetworkTrafficViewModel}"><views:NetworkTrafficView/></DataTemplate>
        <DataTemplate DataType="{x:Type archive:ArchiveRecoveryViewModel}"><views:ArchiveRecoveryView/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#17212B">
            <Grid Margin="20,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="宝哥工具箱" Foreground="#FFFFFF" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Windows 实用工具" Foreground="#92A4B5" FontSize="12" Margin="1,4,0,0"/></StackPanel>
                <RadioButton x:Name="PortNavigation" Grid.Row="1" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools"
                             Command="{Binding ShowPortMonitorCommand}" IsChecked="{Binding IsPortMonitorSelected, Mode=OneWay}" Margin="0,34,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#8FC1FF" Margin="0,0,10,0"/><TextBlock Text="端口监控" FontWeight="SemiBold"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="FileNavigation" Grid.Row="2" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools"
                             Command="{Binding ShowFileUnlockerCommand}" IsChecked="{Binding IsFileUnlockerSelected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="◆" Foreground="#8FC1FF" Margin="0,0,10,0"/><TextBlock Text="文件解锁" FontWeight="SemiBold"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NetworkNavigation" Grid.Row="3" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools"
                             Command="{Binding ShowNetworkTrafficCommand}" IsChecked="{Binding IsNetworkTrafficSelected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="↕" Foreground="#8FC1FF" Margin="0,0,10,0"/><TextBlock Text="网络流量" FontWeight="SemiBold"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ArchiveNavigation" Grid.Row="4" Style="{StaticResource ToolNavigationStyle}" GroupName="Tools"
                             Command="{Binding ShowArchiveRecoveryCommand}" IsChecked="{Binding IsArchiveRecoverySelected, Mode=OneWay}">
                    <TextBlock Text="压缩包密码找回" FontWeight="SemiBold"/>
                </RadioButton>
                <TextBlock Grid.Row="6" Text="更多工具将逐步加入" Foreground="#728597" FontSize="11"/>
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentTool}"/>
    </Grid>
</Window>
