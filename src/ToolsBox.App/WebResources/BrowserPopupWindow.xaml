<Window x:Class="ToolsBox.App.WebResources.BrowserPopupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="独立浏览 · 宝哥工具箱" Width="1200" Height="850" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#F4F6F8">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style></Window.Resources>
 <DockPanel Margin="8">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <Button Content="←" Click="Back"/><Button Content="→" Click="Forward"/><Button Content="刷新" Click="Reload"/>
   <Button Content="返回工具窗口" Click="ReturnToTool" DockPanel.Dock="Right"/><Button Content="打开" Click="Navigate" DockPanel.Dock="Right"/>
   <TextBox x:Name="PopupAddress" Padding="8,5" VerticalContentAlignment="Center" KeyDown="AddressKeyDown"/>
  </DockPanel>
  <TextBlock x:Name="PopupStatus" DockPanel.Dock="Bottom" Text="普通权限浏览 · 共用登录状态 · 资源继续在工具窗口识别" Margin="4,6" TextWrapping="Wrap"/>
  <Border x:Name="PopupBrowserHost" BorderBrush="#CBD2D9" BorderThickness="1"/>
 </DockPanel>
</Window>
