<Window x:Class="ToolsBox.App.WebResources.BrowserLibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="收藏与历史" Width="880" Height="560" MinWidth="720" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="#F4F6F8">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Explanation" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#52606D"/></StackPanel>
  <DataGrid x:Name="AddressesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="AddressSelected" MouseDoubleClick="OpenDoubleClick">
   <DataGrid.Columns>
    <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="2*" MinWidth="120"/>
    <DataGridTextColumn Header="地址" Binding="{Binding Url}" Width="3*" MinWidth="180"/>
    <DataGridTextColumn Header="时间" Binding="{Binding VisitedAt.LocalDateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="135"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Margin="0,10,0,0">
   <DockPanel x:Name="RenamePanel" Margin="0,0,0,6"><Button x:Name="RenameButton" Content="保存名称" Click="RenameFavorite" DockPanel.Dock="Right"/><TextBox x:Name="FavoriteName" MaxLength="300" Padding="8,5" VerticalContentAlignment="Center" ToolTip="收藏名称"/></DockPanel>
   <WrapPanel><Button x:Name="OpenAddressButton" Content="打开所选地址" Click="OpenSelected"/><Button x:Name="DeleteAddressButton" Content="删除所选" Click="DeleteSelected"/><Button x:Name="ClearHistoryButton" Content="清空历史" Click="ClearHistory"/><Button Content="关闭" Click="CloseWindow"/></WrapPanel>
  </StackPanel>
  <TextBlock x:Name="LibraryStatus" Grid.Row="3" TextWrapping="Wrap" Margin="4,8,0,0" Foreground="#52606D"/>
 </Grid>
</Window>
