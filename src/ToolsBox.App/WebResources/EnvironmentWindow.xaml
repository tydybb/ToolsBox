<Window x:Class="ToolsBox.App.WebResources.EnvironmentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="环境检测 · 网页资源下载" Width="760" Height="600" MinWidth="620" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="#F4F6F8">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="环境检测" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="先检查本机环境；仅在确认后下载缺失项，已安装项会跳过。" Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#52606D"/></StackPanel>
  <Border Grid.Row="1" Background="White" Padding="16" Margin="0,0,0,10" CornerRadius="6">
   <StackPanel><TextBlock Text="浏览器环境 · Microsoft WebView2" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="RuntimeStatus" Text="待检测" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" Padding="16" Margin="0,0,0,10" CornerRadius="6">
   <StackPanel><TextBlock Text="视频组件包 · yt-dlp + FFmpeg + ffprobe" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="VideoStatus" Text="待检测" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
  </Border>
  <Expander Grid.Row="3" Header="版本、来源与组件目录" IsExpanded="False" Margin="0,3,0,10">
   <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Background="White"/>
  </Expander>
  <StackPanel Grid.Row="4" Margin="0,5,0,8">
   <TextBlock x:Name="OperationStatus" Text="准备检测…" TextWrapping="Wrap" Margin="0,0,0,7"/>
   <ProgressBar x:Name="OperationProgress" Height="7" Minimum="0" Maximum="100"/>
  </StackPanel>
  <WrapPanel Grid.Row="5">
   <Button x:Name="InstallMissingButton" Content="安装缺失项" Click="InstallMissing" IsEnabled="False" Background="#1769AA" Foreground="White"/>
   <Button x:Name="DetectButton" Content="重新检测" Click="DetectAgain" IsEnabled="False"/>
   <Button x:Name="ImportButton" Content="导入可信组件目录" Click="ImportComponents" IsEnabled="False"/>
   <Button x:Name="CloseButton" Content="关闭" Click="CloseWindow"/>
  </WrapPanel>
 </Grid>
</Window>
