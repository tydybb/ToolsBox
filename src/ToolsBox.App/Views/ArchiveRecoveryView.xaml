<UserControl x:Class="ToolsBox.App.Views.ArchiveRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="压缩包密码找回" FontSize="26" FontWeight="SemiBold" Foreground="#17212B"/>
            <TextBlock Text="仅用于你自己或获授权的压缩包 · 本地验证，不上传、不解压、不修改原包" Foreground="#526475" Margin="0,8,0,16" TextWrapping="Wrap"/>
            <Grid IsEnabled="{Binding CanEdit}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ArchivePathInput" Text="{Binding ArchivePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入路径，或直接从资源管理器拖入单个 ZIP / RAR / 7z 文件"/>
                <Button Grid.Column="1" Content="浏览压缩包…" Command="{Binding BrowseCommand}"/>
            </Grid>
            <TextBlock Text="支持 ZIP（ZipCrypto / AES）、RAR3/4、RAR5、7z（含加密文件头）。不支持分卷、自解压 EXE 或修复损坏。" FontSize="12" Foreground="#526475" TextWrapping="Wrap" Margin="0,8,0,16"/>
            <TabControl SelectedIndex="{Binding Mode}" IsEnabled="{Binding CanEdit}" Padding="14">
                <TabItem Header="候选密码">
                    <StackPanel>
                        <TextBlock Text="每行一个密码，保留空格和大小写，跳过空行。导入文件优先于下方输入。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CandidateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Height="135" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="导入 UTF-8 文本…" Command="{Binding ImportCommand}" Margin="0"/>
                            <Button Content="取消导入，使用输入" Command="{Binding ClearImportCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DictionaryPath}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#526475"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="规则组合">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="已知前缀" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="已知后缀" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox Grid.Column="3" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="未知最小长度" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinimumLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="最大长度" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MaximumLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Text="未知字符集" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Charset, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="生成：前缀 + 未知字符 + 后缀。长度为 0 时只测试前后缀。字符集可输入数字、大小写字母、符号或自定义字符。" TextWrapping="Wrap" Foreground="#526475" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
            <TextBlock Text="{Binding SearchSpace}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="密码越长、字符集越大，尝试时间增长越快。强密码可能无法找回；本工具不保证成功。" Foreground="#996400" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,16,0,16" VerticalAlignment="Center">
                <TextBlock Text="单次验证时限（秒）" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0,12,0" IsEnabled="{Binding CanEdit}"/>
                <Button Content="开始找回" Command="{Binding StartCommand}" Background="#246BFD" Foreground="White"/>
                <Button Content="停止" Command="{Binding StopCommand}"/>
            </WrapPanel>
            <Border Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Warning}" Foreground="#996400" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding PasswordDisplay}" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="显示 / 隐藏" Command="{Binding RevealCommand}" Margin="0"/>
                        <Button Content="复制密码" Command="{Binding CopyCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Button Content="内置引擎与第三方许可" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnLicensesClick"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
