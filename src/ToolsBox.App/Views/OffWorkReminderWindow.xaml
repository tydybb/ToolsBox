<Window x:Class="ToolsBox.App.Views.OffWorkReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="即将关机" Width="520" Height="350" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Background="#0078D7" Foreground="White" FontFamily="Microsoft YaHei UI">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WarningTitle" Grid.Row="0" Text="即将关机" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="ReminderMessage" Text="你已经下班，我要把你电脑关了" Foreground="White" FontSize="18" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock x:Name="FlavorText" Text="{Binding FlavorText}" Foreground="#FFE9A8" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFlavor}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Border Grid.Row="2" Height="1" Background="White" Opacity="0.8" Margin="0,20,0,0"/>

        <StackPanel Grid.Row="3" VerticalAlignment="Center">
            <TextBlock x:Name="OverdueNotice" Text="你已无偿加班" Foreground="White" FontSize="14"/>
            <TextBlock x:Name="OverdueTimer" Text="{Binding ElapsedText}" Foreground="White" FontFamily="Consolas" FontSize="32" Margin="0,4,0,4"/>
            <TextBlock Foreground="White" TextWrapping="Wrap">
                <Run Text="预计下班："/><Run Text="{Binding EndText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="FinishWorkButton" Content="下班" Command="{Binding FinishCommand}"
                    Width="110" Height="36" Margin="0,0,12,0" BorderThickness="1"
                    ToolTip="结束本次计时，并记录实际下班时间">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#16794B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#16794B"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E4E7EB"/>
                                <Setter Property="Foreground" Value="#637381"/>
                                <Setter Property="BorderBrush" Value="#CBD2D9"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="DismissButton" Content="关闭" Width="110" Height="36"
                    Background="#0078D7" Foreground="White"
                    BorderBrush="White" BorderThickness="1" Click="OnDismiss"/>
        </StackPanel>
    </Grid>
</Window>
