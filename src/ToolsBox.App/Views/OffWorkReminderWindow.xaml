<Window x:Class="ToolsBox.App.Views.OffWorkReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="即将关机" Width="700" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Background="{DynamicResource ToolboxBackgroundBrush}" Foreground="{DynamicResource ToolboxTextBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ComfortControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="WarningTitle" Text="即将关机" Foreground="{DynamicResource ToolboxTextBrush}"
                           FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="ReminderMessage" Text="你已经下班，我要把你电脑关了" Foreground="{DynamicResource ToolboxTextBrush}"
                           FontSize="17" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="FlavorText" Text="{Binding FlavorText}" Foreground="{DynamicResource ToolboxWarningTextBrush}"
                           FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFlavor}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Background="{DynamicResource ToolboxSuccessSurfaceBrush}" CornerRadius="12" Padding="18,14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="OverdueNotice" Text="你已无偿加班" Foreground="{DynamicResource ToolboxSuccessTextBrush}" FontSize="14"/>
                        <TextBlock x:Name="OverdueTimer" Text="{Binding ElapsedText}" Foreground="{DynamicResource ToolboxSuccessTextBrush}"
                                   FontFamily="Consolas" FontSize="36" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="预计下班："/><Run Text="{Binding EndText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Image x:Name="ReminderArtworkImage" Grid.Column="2" Width="220" Height="220" Stretch="Uniform"
                   VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="FinishWorkButton" Content="下班" Command="{Binding FinishCommand}"
                    Width="120" Height="42" Margin="0,0,12,0" Style="{StaticResource ToolboxPrimaryButtonStyle}"
                    ToolTip="结束本次计时，并记录实际下班时间"/>
            <Button x:Name="DismissButton" Content="关闭" Width="120" Height="42" Margin="0"
                    Style="{StaticResource ToolboxButtonStyle}" Click="OnDismiss"/>
        </StackPanel>

        <!-- 庆祝特效覆盖层：负边距抵消根 Grid 的 28/24 外边距，正好铺满整扇窗；
             不参与命中测试，纸屑与烟花不会挡住“下班 / 关闭”按钮。 -->
        <Canvas x:Name="CelebrationCanvas" Grid.RowSpan="2" Margin="-28,-24" IsHitTestVisible="False"/>
    </Grid>
</Window>
