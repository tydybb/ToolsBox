<UserControl x:Class="ToolsBox.App.Views.FileUnlockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnDrop"
             Background="{DynamicResource ToolboxBackgroundBrush}" Foreground="{DynamicResource ToolboxTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="TableCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,28,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="文件解除占用" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ToolboxTextBrush}"/>
            <TextBlock Text="检测文件或文件夹的占用进程，并按需解除占用" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPath}" VerticalContentAlignment="Center" ToolTip="输入文件或文件夹完整路径"/>
            <Button Grid.Column="1" Content="选择文件" Click="OnBrowseFile" IsEnabled="{Binding CanEditPath}"/><Button Grid.Column="2" Content="选择文件夹" Click="OnBrowseFolder" IsEnabled="{Binding CanEditPath}"/>
            <Button Grid.Column="3" Content="检测占用" Command="{Binding ScanCommand}" Style="{DynamicResource ToolboxPrimaryButtonStyle}"/>
            <Button Grid.Column="4" Content="管理员扫描" Command="{Binding ElevatedScanCommand}"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1" Background="{DynamicResource ToolboxInfoSurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <TextBlock Text="可将单个文件或文件夹直接拖到此窗口，放下后会自动识别并扫描。文件夹会包含全部子项。" Foreground="{DynamicResource ToolboxInfoTextBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource ToolboxSurfaceBrush}" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
            <DataGrid ItemsSource="{Binding Entries}" Style="{DynamicResource ToolboxDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource ToolboxHoverBrush}" ColumnHeaderHeight="42" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="80" MinWidth="80" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Content="全选" IsThreeState="True"
                                          IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          IsEnabled="{Binding DataContext.CanSelectEntries, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsEnabled="{Binding DataContext.CanSelectEntries, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="进程" Binding="{Binding ProcessName}" IsReadOnly="True" Width="130" MinWidth="130"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="PID" Binding="{Binding ProcessId}" IsReadOnly="True" Width="75" MinWidth="75"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="占用路径" Binding="{Binding LockedPath}" IsReadOnly="True" Width="*" MinWidth="240"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="句柄" Binding="{Binding HandleDisplay}" IsReadOnly="True" Width="90" MinWidth="90"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="权限" Binding="{Binding PermissionDisplay}" IsReadOnly="True" Width="85" MinWidth="85"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="进程路径" Binding="{Binding ProcessPath}" IsReadOnly="True" Width="220" MinWidth="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="4" Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ToolboxMutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,6,0,0">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 条记录，涉及 "/><Run Text="{Binding SelectedProcessCount, Mode=OneWay}"/><Run Text=" 个进程"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="强制结束所选进程" HorizontalAlignment="Right" Click="OnTerminateProcesses" IsEnabled="{Binding CanActOnSelectedEntries}" Style="{DynamicResource ToolboxDangerButtonStyle}" ToolTip="只强制结束确认清单中的进程，不递归结束子进程；未保存数据可能丢失。"/>
        </Grid>
        <Expander Grid.Row="5" Header="高级危险操作" IsExpanded="{Binding IsAdvancedExpanded}" Foreground="{DynamicResource ToolboxDangerTextBrush}">
            <Border Background="{DynamicResource ToolboxWarningSurfaceBrush}" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0">
                <DockPanel LastChildFill="True"><Button Content="强制关闭所选句柄" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnCloseHandles" IsEnabled="{Binding CanActOnSelectedEntries}" Style="{DynamicResource ToolboxDangerButtonStyle}"/><TextBlock Text="强制关闭句柄可能使占用程序崩溃或损坏未保存数据。" Foreground="{DynamicResource ToolboxWarningTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/></DockPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
