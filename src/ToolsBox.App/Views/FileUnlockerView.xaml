<UserControl x:Class="ToolsBox.App.Views.FileUnlockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnDrop">
    <Grid Margin="28,24,28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="文件解锁" FontSize="28" FontWeight="SemiBold" Foreground="#1F2933"/>
            <TextBlock Text="检测文件或文件夹的占用进程，并按需解除占用" Foreground="#637381" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="输入文件或文件夹完整路径"/>
            <Button Grid.Column="1" Content="选择文件" Click="OnBrowseFile"/><Button Grid.Column="2" Content="选择文件夹" Click="OnBrowseFolder"/>
            <Button Grid.Column="3" Content="检测占用" Command="{Binding ScanCommand}" Background="#246BFD" Foreground="White" BorderBrush="#246BFD"/>
            <Button Grid.Column="4" Content="管理员扫描" Command="{Binding ElevatedScanCommand}"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#8FB7FF" BorderThickness="1" Background="#EEF5FF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="可将单个文件或文件夹直接拖到此窗口，放下后会自动识别并扫描。文件夹会包含全部子项。" Foreground="#315A8A" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC" ColumnHeaderHeight="38" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="80" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Content="全选" IsThreeState="True"
                                          IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          IsEnabled="{Binding DataContext.CanSelectEntries, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsEnabled="{Binding DataContext.CanSelectEntries, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" IsReadOnly="True" Width="130"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" IsReadOnly="True" Width="75"/>
                    <DataGridTextColumn Header="占用路径" Binding="{Binding LockedPath}" IsReadOnly="True" Width="*" MinWidth="240"/>
                    <DataGridTextColumn Header="句柄" Binding="{Binding HandleDisplay}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="权限" Binding="{Binding PermissionDisplay}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="进程路径" Binding="{Binding ProcessPath}" IsReadOnly="True" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="4" Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding StatusText}" Foreground="#52616B" TextWrapping="Wrap"/>
                <TextBlock Foreground="#52616B" Margin="0,4,0,0">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 条记录，涉及 "/><Run Text="{Binding SelectedProcessCount, Mode=OneWay}"/><Run Text=" 个进程"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="安全结束所选进程" HorizontalAlignment="Right" Click="OnTerminateProcesses" IsEnabled="{Binding CanActOnSelectedEntries}" Background="#FFF2F2" BorderBrush="#EAA4A4" Foreground="#9B2C2C"/>
        </Grid>
        <Expander Grid.Row="5" Header="高级危险操作" IsExpanded="{Binding IsAdvancedExpanded}" Foreground="#9B2C2C">
            <Border Background="#FFF7ED" BorderBrush="#F1B97A" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,8,0,0">
                <DockPanel><TextBlock Text="强制关闭句柄可能使占用程序崩溃或损坏未保存数据。" Foreground="#8A4B08" VerticalAlignment="Center"/><Button Content="强制关闭所选句柄" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnCloseHandles" IsEnabled="{Binding CanActOnSelectedEntries}" Background="#C53030" Foreground="White" BorderBrush="#C53030"/></DockPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
