<Window x:Class="ToolsBox.App.Views.ProcessTerminationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认强制结束进程" Width="880" Height="580" MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="请核对要结束的进程" FontSize="24" FontWeight="SemiBold" Foreground="#9B2C2C"/>
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="检测目标：" Foreground="#637381"/>
            <TextBlock x:Name="TargetPathText" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <DataGrid x:Name="ProcessList" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="180" MinWidth="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="ToolTip" Value="{Binding ProcessName}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="程序路径" Binding="{Binding ProcessPath}" Width="*" MinWidth="280">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="ToolTip" Value="{Binding ProcessPath}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,14,0,14">
            <TextBlock Text="这是强制终止，不是正常关闭窗口。未保存数据可能丢失，程序正在写入的文件可能损坏。即使不递归结束子进程，该软件的关联窗口或服务仍可能随它退出。建议优先回到软件中保存并正常关闭。"
                       Foreground="#9B2C2C" TextWrapping="Wrap" LineHeight="20"/>
            <CheckBox x:Name="RiskAcknowledgement" Margin="0,12,0,0">
                <TextBlock Text="我已核对以上全部进程，理解未保存数据可能丢失。" TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True" MinWidth="100" Padding="14,8" Margin="0,0,12,0"/>
            <Button x:Name="ConfirmTerminationButton" Content="确认强制结束" IsEnabled="{Binding IsChecked, ElementName=RiskAcknowledgement}"
                    Click="OnConfirm" MinWidth="130" Padding="14,8" Background="#C53030" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
