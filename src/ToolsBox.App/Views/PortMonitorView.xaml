<UserControl x:Class="ToolsBox.App.Views.PortMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ToolsBox.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <infra:PortClipboardFormatter x:Key="PortClipboardFormatter"/>
        <Style x:Key="PortCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolboxTextBrush}"/>
        </Style>
        <Style x:Key="PortMonoText" TargetType="TextBlock" BasedOn="{StaticResource PortCellText}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,28,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="端口监控" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="实时查看 TCP / UDP 端口占用，快速找到对应进程" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,6,0,0"/></StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="16" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ToolboxSuccessSurfaceBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Background" Value="{DynamicResource ToolboxHoverBrush}"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource ToolboxSuccessTextBrush}" Margin="0,0,7,0"/><TextBlock FontSize="12">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="自动刷新中"/><Setter Property="Foreground" Value="{DynamicResource ToolboxSuccessTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Text" Value="已暂停"/><Setter Property="Foreground" Value="{DynamicResource ToolboxMutedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PortSearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索端口、PID、进程、协议、状态或地址">
                <TextBox.Template><ControlTemplate TargetType="TextBox">
                    <Border x:Name="SearchBorder" Background="{DynamicResource ToolboxSurfaceBrush}" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="38,8,10,8"/>
                            <TextBlock x:Name="SearchHint" Text="搜索端口、进程或 PID" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="38,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="SearchHint" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource ToolboxAccentBrush}"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></TextBox.Template>
            </TextBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,2,0" VerticalAlignment="Center">
                <TextBlock Text="刷新" VerticalAlignment="Center" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="PortRefreshInterval" Width="82" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshIntervalSeconds}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} 秒}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding TogglePauseCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding PauseButtonText}"/></StackPanel></Button>
            <Button Grid.Column="3" Command="{Binding RefreshCommand}" Style="{DynamicResource ToolboxPrimaryButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="立即刷新"/></StackPanel></Button>
        </Grid>
        <Border Grid.Row="2" Padding="14,10" Margin="0,0,0,16" Background="{DynamicResource ToolboxWarningSurfaceBrush}" CornerRadius="8" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ToolboxWarningTextBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3" Style="{DynamicResource ToolboxCardStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="右键按字段排序 · Ctrl+C 复制" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="端口列表" FontWeight="SemiBold"/></StackPanel></DockPanel>
                </Border>
                <DataGrid x:Name="PortGrid" Grid.Row="1" ItemsSource="{Binding Entries}" Style="{DynamicResource ToolboxDataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="True" CanUserSortColumns="True" RowHeight="56" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.ContextMenu>
                        <ContextMenu Style="{DynamicResource ToolboxContextMenuStyle}">
                            <MenuItem Header="按进程名排序" Tag="ProcessName" Click="OnSortByField"/>
                            <MenuItem Header="按 PID 排序" Tag="ProcessId" Click="OnSortByField"/>
                            <MenuItem Header="按协议排序" Tag="Protocol" Click="OnSortByField"/>
                            <MenuItem Header="按地址族排序" Tag="AddressFamilyDisplay" Click="OnSortByField"/>
                            <MenuItem Header="按本地地址排序" Tag="LocalAddress" Click="OnSortByField"/>
                            <MenuItem Header="按本地端口排序" Tag="LocalPort" Click="OnSortByField"/>
                            <MenuItem Header="按远程地址排序" Tag="RemoteAddress" Click="OnSortByField"/>
                            <MenuItem Header="按远程端口排序" Tag="RemotePort" Click="OnSortByField"/>
                            <MenuItem Header="按状态排序" Tag="State" Click="OnSortByField"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="进程 / PID" SortMemberPath="ProcessName" Width="1.15*" MinWidth="160">
                            <DataGridTemplateColumn.ClipboardContentBinding><MultiBinding Converter="{StaticResource PortClipboardFormatter}" ConverterParameter="{}{0} (PID {1})"><Binding Path="ProcessName"/><Binding Path="ProcessId"/></MultiBinding></DataGridTemplateColumn.ClipboardContentBinding>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}"/><TextBlock Text="{Binding ProcessId}" Style="{StaticResource PortMonoText}" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="协议" SortMemberPath="Protocol" Width="80">
                            <DataGridTemplateColumn.ClipboardContentBinding><MultiBinding Converter="{StaticResource PortClipboardFormatter}" ConverterParameter="{}{0} / {1}"><Binding Path="Protocol"/><Binding Path="AddressFamilyDisplay"/></MultiBinding></DataGridTemplateColumn.ClipboardContentBinding>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Protocol}"/><TextBlock Text="{Binding AddressFamilyDisplay}" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="本地地址 / 端口" SortMemberPath="LocalPort" Width="1.2*" MinWidth="155">
                            <DataGridTemplateColumn.ClipboardContentBinding><MultiBinding Converter="{StaticResource PortClipboardFormatter}" ConverterParameter="{}[{0}]:{1}"><Binding Path="LocalAddress"/><Binding Path="LocalPort"/></MultiBinding></DataGridTemplateColumn.ClipboardContentBinding>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding LocalAddress}" Style="{StaticResource PortMonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalAddress}"/><TextBlock Text="{Binding LocalPort}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ToolboxAccentBrush}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="远程地址 / 端口" SortMemberPath="RemotePort" Width="1.2*" MinWidth="155">
                            <DataGridTemplateColumn.ClipboardContentBinding><MultiBinding Converter="{StaticResource PortClipboardFormatter}" ConverterParameter="{}[{0}]:{1}"><Binding Path="RemoteAddress"/><Binding Path="RemotePort" TargetNullValue="—"/></MultiBinding></DataGridTemplateColumn.ClipboardContentBinding>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RemoteAddress}" Style="{StaticResource PortMonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteAddress}"/><TextBlock Text="{Binding RemotePort, TargetNullValue=—}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" SortMemberPath="State" Width="130">
                            <DataGridTemplateColumn.ClipboardContentBinding><Binding Path="State"/></DataGridTemplateColumn.ClipboardContentBinding>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Padding="8,4" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource ToolboxHoverBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Established"><Setter Property="Background" Value="{DynamicResource ToolboxSuccessSurfaceBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding State}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ToolboxMutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Established"><Setter Property="Foreground" Value="{DynamicResource ToolboxSuccessTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource ToolboxBackgroundBrush}" Padding="16,12">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=PortGrid}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ContentControl Content="{Binding SelectedItem, ElementName=PortGrid}"><ContentControl.ContentTemplate><DataTemplate><WrapPanel>
                        <StackPanel Margin="0,0,22,0"><TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11"/></StackPanel>
                        <StackPanel Margin="0,0,22,0"><TextBlock Text="本地端点" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11"/><TextBlock FontFamily="Consolas" FontSize="12"><Run Text="{Binding LocalAddress, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding LocalPort, Mode=OneWay}"/></TextBlock></StackPanel>
                        <StackPanel Margin="0,0,22,0"><TextBlock Text="远程端点" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11"/><TextBlock FontFamily="Consolas" FontSize="12"><Run Text="{Binding RemoteAddress, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding RemotePort, Mode=OneWay, TargetNullValue=—}"/></TextBlock></StackPanel>
                        <StackPanel><TextBlock Text="协议 / 地址族" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11"/><TextBlock><Run Text="{Binding Protocol, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AddressFamilyDisplay, Mode=OneWay}"/></TextBlock></StackPanel>
                    </WrapPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="2,14,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" Text="{Binding LastRefreshText}" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="12" Margin="16,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
