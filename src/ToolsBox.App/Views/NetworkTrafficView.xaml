<UserControl x:Class="ToolsBox.App.Views.NetworkTrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ToolboxBackgroundBrush}" Foreground="{DynamicResource ToolboxTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ActionCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolboxTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TableCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,28,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="网络流量" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ToolboxTextBrush}"/>
            <TextBlock Text="实时更新流量，已有软件保持原位，新软件追加到底部；支持持久化上传限速" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="开始监控" Command="{Binding StartCommand}" Style="{DynamicResource ToolboxPrimaryButtonStyle}" Margin="0"/>
            <Button Grid.Column="1" Content="停止监控" Command="{Binding StopCommand}"/>
            <TextBox Grid.Column="2" Margin="16,0,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索软件名称、程序路径或 PID"/>
            <CheckBox Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Content="仅显示有流量" IsChecked="{Binding ShowActiveOnly}"/>
        </Grid>

        <Border Grid.Row="2" Padding="16" Margin="0,0,0,16" Background="{DynamicResource ToolboxWarningSurfaceBrush}" CornerRadius="10"
                Visibility="{Binding HasDroppedEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="事件队列曾发生溢出，当前会话统计可能不完整。" Foreground="{DynamicResource ToolboxWarningTextBrush}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource ToolboxSurfaceBrush}" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
            <DataGrid ItemsSource="{Binding Items}" Style="{DynamicResource ToolboxDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" BorderThickness="0" RowHeaderWidth="0"
                      AlternatingRowBackground="{DynamicResource ToolboxHoverBrush}" ColumnHeaderHeight="42" RowHeight="52"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource ToolboxTextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource ToolboxSurfaceBrush}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource ToolboxHoverBrush}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ToolboxHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ToolboxSelectionBrush}"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ToolboxBackgroundBrush}" BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="0,1,0,1" Padding="42,12,16,16">
                            <DataGrid ItemsSource="{Binding Processes}" Style="{DynamicResource ToolboxDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                                      Background="{DynamicResource ToolboxSurfaceBrush}" RowHeaderWidth="0" GridLinesVisibility="Horizontal" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="PID" Binding="{Binding ProcessId}" Width="75" MinWidth="75"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="进程" Binding="{Binding ProcessName}" Width="*" MinWidth="150"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="启动时间" Binding="{Binding StartedAtText}" Width="145" MinWidth="145"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="上传" Binding="{Binding UploadRateText}" Width="105" MinWidth="105"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="下载" Binding="{Binding DownloadRateText}" Width="105" MinWidth="105"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="累计上传" Binding="{Binding TotalUploadText}" Width="105" MinWidth="105"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="累计下载" Binding="{Binding TotalDownloadText}" Width="105" MinWidth="105"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="状态" Binding="{Binding StateText}" Width="70" MinWidth="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="38" MinWidth="38" CellStyle="{StaticResource ActionCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="▸" Padding="5,1" Margin="2" MinHeight="38" MinWidth="30" ToolTip="展开或收起进程" Click="OnToggleDetails"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="软件" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" Foreground="{DynamicResource ToolboxTextBrush}"/>
                                        <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource ToolboxMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="上传" Binding="{Binding UploadRateText}" Width="95" MinWidth="95"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="下载" Binding="{Binding DownloadRateText}" Width="95" MinWidth="95"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="累计上传" Binding="{Binding TotalUploadText}" Width="100" MinWidth="100"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="累计下载" Binding="{Binding TotalDownloadText}" Width="100" MinWidth="100"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="进程数" Binding="{Binding ProcessCount}" Width="65" MinWidth="65"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="上传限速" Binding="{Binding LimitText}" Width="115" MinWidth="115"/>
                    <DataGridTemplateColumn Header="操作" Width="72" MinWidth="72" CellStyle="{StaticResource ActionCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="设置" Padding="10,5" Margin="3" IsEnabled="{Binding CanLimit}" Click="OnEditLimit" ToolTip="{Binding LimitWarning}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ToolboxMutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastSampleText}" Foreground="{DynamicResource ToolboxMutedBrush}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
