<UserControl x:Class="ToolsBox.App.Views.NetworkTrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="网络流量" FontSize="28" FontWeight="SemiBold" Foreground="#1F2933"/>
            <TextBlock Text="实时更新流量，已有软件保持原位，新软件追加到底部；支持持久化上传限速" Foreground="#637381" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="开始监控" Command="{Binding StartCommand}" Background="#246BFD" Foreground="White" BorderBrush="#246BFD" Margin="0"/>
            <Button Grid.Column="1" Content="停止监控" Command="{Binding StopCommand}"/>
            <TextBox Grid.Column="2" Margin="16,0,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索软件名称、程序路径或 PID"/>
            <CheckBox Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Content="仅显示有流量" IsChecked="{Binding ShowActiveOnly}"/>
        </Grid>

        <Border Grid.Row="2" Padding="12,9" Margin="0,0,0,12" Background="#FFF3CD" CornerRadius="4"
                Visibility="{Binding HasDroppedEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="事件队列曾发生溢出，当前会话统计可能不完整。" Foreground="#7A5800" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" BorderThickness="0" RowHeaderWidth="0"
                      AlternatingRowBackground="#F8FAFC" ColumnHeaderHeight="38" RowHeight="52"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F4F7FA" BorderBrush="#DDE3E8" BorderThickness="0,1,0,1" Padding="42,8,12,10">
                            <DataGrid ItemsSource="{Binding Processes}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                                      Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal" RowHeight="30">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75"/>
                                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="*" MinWidth="150"/>
                                    <DataGridTextColumn Header="启动时间" Binding="{Binding StartedAtText}" Width="145"/>
                                    <DataGridTextColumn Header="上传" Binding="{Binding UploadRateText}" Width="105"/>
                                    <DataGridTextColumn Header="下载" Binding="{Binding DownloadRateText}" Width="105"/>
                                    <DataGridTextColumn Header="累计上传" Binding="{Binding TotalUploadText}" Width="105"/>
                                    <DataGridTextColumn Header="累计下载" Binding="{Binding TotalDownloadText}" Width="105"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="38">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="▸" Padding="5,1" Margin="2" ToolTip="展开或收起进程" Click="OnToggleDetails"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="软件" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" Foreground="#25313C"/>
                                        <TextBlock Text="{Binding ExecutablePath}" Foreground="#7B8794" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="上传" Binding="{Binding UploadRateText}" Width="95"/>
                    <DataGridTextColumn Header="下载" Binding="{Binding DownloadRateText}" Width="95"/>
                    <DataGridTextColumn Header="累计上传" Binding="{Binding TotalUploadText}" Width="100"/>
                    <DataGridTextColumn Header="累计下载" Binding="{Binding TotalDownloadText}" Width="100"/>
                    <DataGridTextColumn Header="进程数" Binding="{Binding ProcessCount}" Width="65"/>
                    <DataGridTextColumn Header="上传限速" Binding="{Binding LimitText}" Width="115"/>
                    <DataGridTemplateColumn Header="操作" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="设置" Padding="10,5" Margin="3" IsEnabled="{Binding CanLimit}" Click="OnEditLimit" ToolTip="{Binding LimitWarning}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#52616B" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastSampleText}" Foreground="#7B8794" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
