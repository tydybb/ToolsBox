<UserControl x:Class="ToolsBox.App.Views.WorkCountdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:attendance="clr-namespace:ToolsBox.App.Attendance"
             xmlns:countdown="clr-namespace:ToolsBox.App.WorkCountdown"
             Background="{DynamicResource ToolboxBackgroundBrush}" Foreground="{DynamicResource ToolboxTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,28,28,24">
            <TextBlock Text="下班倒计时" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ToolboxTextBrush}"/>
            <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,6,0,20"/>
            <Border x:Name="CountdownCard" Background="{DynamicResource ToolboxSurfaceBrush}" CornerRadius="16" Padding="10"
                    BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55*" MinWidth="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="45*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="CountdownCopyPanel">
                        <TextBlock x:Name="CountdownDayFacts" Text="{Binding Card.FactText}" Foreground="{DynamicResource ToolboxMutedBrush}"
                                   FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="FlavorText" Text="{Binding Card.Headline}" Foreground="{DynamicResource ToolboxWarningTextBrush}"
                                   FontSize="15" FontWeight="SemiBold" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CountdownStatusText" Text="{Binding FinishMessage}" TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ToolboxSuccessTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ToolboxWarningTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="OverdueNotice" Text="你已无偿加班" Foreground="{DynamicResource ToolboxDangerTextBrush}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="FinishedTimerCaption" Text="{Binding FinishedTimerLabel}" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="CountdownText" Text="{Binding TimerText}" FontFamily="Consolas" FontSize="50" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ToolboxAccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ToolboxDangerTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ToolboxSuccessTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ToolboxWarningTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="AttendanceText" Text="{Binding AttendanceText}" Foreground="{DynamicResource ToolboxWarningTextBrush}" FontSize="15" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Schedule}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel x:Name="OvertimePanel" Margin="0,2,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOvertime}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="OvertimeDuration" Text="{Binding OvertimeDurationText}" Foreground="{DynamicResource ToolboxSuccessTextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="FinishDetailsText" Text="{Binding FinishDetails}" Foreground="{DynamicResource ToolboxMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="CountdownCharacterCaption"
                                   Text="{Binding Card.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource ToolboxMutedBrush}"
                                   FontSize="13" LineHeight="20" Margin="0,0,0,4"/>
                    </StackPanel>
                    <Grid x:Name="CountdownCharacterArea" Grid.Column="2" MinHeight="160" ClipToBounds="True">
                        <countdown:CountdownCompanion x:Name="CountdownCharacter" CharacterSize="80"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            AnimationKey="{Binding Reaction.AnimationKey}" CharacterName="{Binding Reaction.CharacterName}"
                            SpeechText="{Binding Card.SpeechText}" EffectKey="{Binding Card.EffectKey}"
                            AnimationEnabled="{Binding AnimationEnabled}" IsDarkTheme="{DynamicResource ToolboxIsDarkTheme}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="正常下班" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Grid.Column="1" Text="{Binding NormalEndText}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="预计下班" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndText}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="加班扣除休息" Foreground="{DynamicResource ToolboxMutedBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BreakText}" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" Foreground="{DynamicResource ToolboxWarningTextBrush}" Margin="0,16,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border x:Name="CountdownSettingsCard" Background="{DynamicResource ToolboxSurfaceBrush}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource ToolboxBorderBrush}" BorderThickness="1" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="今日计时设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="上班时间（最早 07:30）" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="使用当前时间" Command="{Binding UseCurrentTimeCommand}"/>
                                <TextBox x:Name="StartTimeInput" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" MinWidth="80" ToolTip="支持半角/全角冒号或四位数字，例如 08:30、08：30、0830"/>
                            </DockPanel>
                            <TextBlock Text="支持 08:30 / 08：30 / 0830" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="加班时长（整数小时）" Margin="0,0,0,6"/>
                            <TextBox x:Name="OvertimeInput" Text="{Binding OvertimeText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ToolTip="留空按 0 处理；工作日加班至少 2 小时；周末节假日至少 4 小时"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding OvertimeHint}" Foreground="{DynamicResource ToolboxMutedBrush}" Margin="0,8,0,16"/>
                    <TextBlock Text="当天类型（公司安排不同时可手动覆盖）" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DayModeInput" ItemsSource="{Binding DayChoices}" DisplayMemberPath="Label" SelectedValuePath="Mode"
                              SelectedValue="{Binding DayMode, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding CalendarText}" Foreground="{DynamicResource ToolboxAccentBrush}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button x:Name="StartCountdownButton" Content="开始 / 重新计算" Command="{Binding StartCommand}" Margin="0"
                                Style="{DynamicResource ToolboxPrimaryButtonStyle}"/>
                        <Button x:Name="FinishWorkButton" Content="下班" Command="{Binding FinishCommand}"
                                Margin="8,0,0,0" BorderThickness="1" Style="{DynamicResource ToolboxPrimaryButtonStyle}"
                                Background="{DynamicResource ToolboxSuccessSurfaceBrush}" Foreground="{DynamicResource ToolboxSuccessTextBrush}" BorderBrush="{DynamicResource ToolboxSuccessTextBrush}"
                                ToolTip="结束本次计时，并记录实际下班时间"/>
                        <Button Content="重置" Command="{Binding ResetCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ToolboxDangerTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <attendance:AttendancePanel Margin="0,20,0,0"/>
            <TextBlock Margin="0,20,0,0" Foreground="{DynamicResource ToolboxMutedBrush}" TextWrapping="Wrap" LineHeight="22"
                       Text="工作日 07:30—09:30 上班，9 小时后下班（含午休）；晚于 09:30 标记迟到，正常下班仍为 18:30。&#10;加班跳过 12:00—13:00 和 19:00—19:30，只有实际跨过的休息时段才扣除。倒计时是距离下班的真实时间，吃饭时仍继续倒数。&#10;内置中国大陆 2026 年官方节假日与调休安排，离线可用；其他年份请手动选择日期类型。切换工具继续计时，同日重开可恢复。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
