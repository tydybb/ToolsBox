<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ToolsBox.Core\ToolsBox.Core.csproj" />
    <ProjectReference Include="..\ToolsBox.Windows\ToolsBox.Windows.csproj" />
    <ProjectReference Include="..\ToolsBox.MediaDownloads\ToolsBox.MediaDownloads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\baoge-toolbox.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- WinForms 只为托盘图标引入，不让它的类型进入全局 using 与 WPF 产生歧义。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>宝哥工具箱</AssemblyName>
    <RootNamespace>ToolsBox.App</RootNamespace>
    <ApplicationIcon>Assets\baoge-toolbox.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>宝哥工具箱</Title>
    <Product>宝哥工具箱</Product>
    <Description>面向 Windows 的端口监控与文件解除占用工具箱</Description>
  </PropertyGroup>

</Project>
